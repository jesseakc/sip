# Compiled output
/target/
**/target/

# Cargo (Cargo.lock is committed for binary crates)
*.rs.bk

# Node.js
node_modules/
.next/
out/
dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Plugin build output IS the deployment unit: the SIP API serves it from
# /api/v1/ui/plugins/<id>/app/. Keep it tracked so a clone has a working plugin.
!plugins/*/dist/

# Fixtures are copied into a plugin's public/ by its prebuild step; the source of
# truth is data/<corpus>/fixture/.
plugins/*/public/fixtures/

# Environment
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/
*.profraw

# Test data
# The raw source corpus is committed; derived fixtures are generated. See
# data/smrt-maintenance-logs/README.md for the one-command rebuild.
data/*/fixture/

# TypeScript build artifacts
*.tsbuildinfo

# SQLx
.sqlx/

# Frontend build
frontend/.next/
frontend/out/
frontend/dist/
frontend/node_modules/
*.tsbuildinfo

# Downloaded corpora and derived fixture bundles. The code that consumes them
# stays in the repo; the records themselves are the operator's to fetch locally.
data/*/raw/
plugins/*/dist/fixtures/

# Python bytecode (never commit compiled caches)
__pycache__/
*.pyc
