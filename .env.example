# ─── Environment ─────────────────────────────────────────────────────────────
# SIP_ENV=local|development|test|staging|production
SIP_ENV=development

# ─── Server ──────────────────────────────────────────────────────────────────
SIP_SERVER_HOST=0.0.0.0
SIP_SERVER_PORT=8000

# ─── Database ────────────────────────────────────────────────────────────────
SIP_DATABASE_URL=postgres://sip:sip@localhost:5432/sip
# SIP_DATABASE_MAX_CONNECTIONS=10
# SIP_DATABASE_CONNECT_TIMEOUT_SECONDS=5

# ─── Redis ────────────────────────────────────────────────────────────────────
SIP_REDIS_URL=redis://localhost:6379

# ─── Object Storage (MinIO) ──────────────────────────────────────────────────
# SIP_OBJECT_STORAGE_ENABLED=true
SIP_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
SIP_OBJECT_STORAGE_ACCESS_KEY=minioadmin
SIP_OBJECT_STORAGE_SECRET_KEY=minioadmin
SIP_OBJECT_STORAGE_BUCKET=sip-documents

# ─── Auth ────────────────────────────────────────────────────────────────────
SIP_AUTH_JWT_SECRET=change-me-in-production-jwt-secret-min-32-chars
SIP_AUTH_JWT_EXPIRATION_SECONDS=900
SIP_AUTH_REFRESH_EXPIRATION_SECONDS=604800

# ─── AI / LLM ────────────────────────────────────────────────────────────────
# Set SIP_AI_ENABLED=true to enable AI features
SIP_AI_ENABLED=false
# Provider: ollama|openai|anthropic|openrouter|azure_openai|bedrock|custom_http|disabled
SIP_AI_PROVIDER=disabled
# SIP_AI_TIMEOUT_SECONDS=60
# SIP_AI_MAX_RETRIES=2
# SIP_AI_STREAMING_ENABLED=true
# SIP_AI_REQUEST_LOGGING_ENABLED=false
# SIP_AI_DEFAULT_TEMPERATURE=0.2
# SIP_AI_DEFAULT_MAX_TOKENS=4096

# ── Ollama (local) ───────────────────────────────────────────────────────
# SIP_AI_OLLAMA_URL=http://localhost:11434
# SIP_AI_OLLAMA_MODEL=llama3.1:8b
# SIP_AI_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── OpenAI ───────────────────────────────────────────────────────────────
# SIP_AI_OPENAI_API_KEY=sk-your-key-here
# SIP_AI_OPENAI_BASE_URL=https://api.openai.com/v1
# SIP_AI_OPENAI_MODEL=gpt-4o

# ── Anthropic ─────────────────────────────────────────────────────────────
# SIP_AI_ANTHROPIC_API_KEY=sk-ant-your-key-here
# SIP_AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
# SIP_AI_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── OpenRouter ────────────────────────────────────────────────────────────
# SIP_AI_OPENROUTER_API_KEY=sk-or-your-key-here
# SIP_AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# SIP_AI_OPENROUTER_MODEL=openai/gpt-4o

# ── Azure OpenAI ──────────────────────────────────────────────────────────
# SIP_AI_AZURE_OPENAI_API_KEY=your-azure-key-here
# SIP_AI_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# SIP_AI_AZURE_OPENAI_DEPLOYMENT=gpt-4o
# SIP_AI_AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── AWS Bedrock ───────────────────────────────────────────────────────────
# SIP_AI_BEDROCK_REGION=us-east-1
# SIP_AI_BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0
# SIP_AI_BEDROCK_USE_CREDENTIAL_CHAIN=true

# ── Custom HTTP Provider ──────────────────────────────────────────────────
# SIP_AI_CUSTOM_LLM_BASE_URL=http://your-llm-proxy:8080/v1
# SIP_AI_CUSTOM_LLM_API_KEY=optional-api-key
# SIP_AI_CUSTOM_LLM_MODEL=your-model-name
# SIP_AI_CUSTOM_LLM_AUTH_HEADER_NAME=X-API-Key
# SIP_AI_CUSTOM_LLM_AUTH_HEADER_PREFIX=Bearer

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Enable/disable major SIP capabilities at runtime.
# All default to true except those noted.
# SIP_FEATURES_AI_CHAT_ENABLED=true
# SIP_FEATURES_RAG_ENABLED=true
# SIP_FEATURES_GRAPH_ENABLED=true
# SIP_FEATURES_PLUGIN_SYSTEM_ENABLED=false  (default: false)
# SIP_FEATURES_DOCUMENT_INGESTION_ENABLED=true
# SIP_FEATURES_SEMANTIC_SEARCH_ENABLED=true
# SIP_FEATURES_DISPATCH_ENABLED=true
# SIP_FEATURES_PARTS_INVENTORY_ENABLED=true
# SIP_FEATURES_DISPOSABLES_TRACKING_ENABLED=false  (default: false)
# SIP_FEATURES_BILLING_ENABLED=false  (default: false)
# SIP_FEATURES_API_DOCS_ENABLED=true
# SIP_FEATURES_MARKETPLACE_ENABLED=false  (default: false)
# SIP_FEATURES_EXPERIMENTAL_ENABLED=false  (default: false)

# ─── Security ─────────────────────────────────────────────────────────────────
# SIP_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3000
# SIP_SECURITY_REQUIRE_HTTPS=false
# SIP_SECURITY_RATE_LIMIT_RPM=300

# ─── Observability ────────────────────────────────────────────────────────────
# SIP_OBSERVABILITY_LOG_LEVEL=info
RUST_LOG=info
RUST_BACKTRACE=1
# SIP_OBSERVABILITY_OTLP_ENDPOINT=
# SIP_OBSERVABILITY_METRICS_ENABLED=false

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── Backward Compatibility ───────────────────────────────────────────────────
# These old-style variables still work (mapped to SIP_AI_OLLAMA_* internally).
SIP_OLLAMA_URL=http://localhost:11434
SIP_OLLAMA_MODEL=llama3.1:8b
