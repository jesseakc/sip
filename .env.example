# Core
RUST_LOG=info
RUST_BACKTRACE=1
SIP_APP_ENV=development
SIP_SERVER_HOST=0.0.0.0
SIP_SERVER_PORT=8000

# Database
SIP_DATABASE_URL=postgres://sip:sip@localhost:5432/sip

# Redis
SIP_REDIS_URL=redis://localhost:6379

# Object Storage (MinIO)
SIP_MINIO_ENDPOINT=http://localhost:9000
SIP_MINIO_ACCESS_KEY=minioadmin
SIP_MINIO_SECRET_KEY=minioadmin
SIP_MINIO_BUCKET=sip-documents

# Auth
SIP_JWT_SECRET=change-me-in-production-jwt-secret-min-32-chars
SIP_JWT_EXPIRATION_SECONDS=900
SIP_REFRESH_EXPIRATION_SECONDS=604800

# AI / Ollama
SIP_OLLAMA_URL=http://localhost:11434
SIP_OLLAMA_MODEL=llama3.1:8b

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
